<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Piik</AssemblyName>
    <RootNamespace>PiikDesktop</RootNamespace>
    <ApplicationIcon>..\..\public\favicon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3351.48" GeneratePathProperty="true" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Include="Resources\shim.js" LogicalName="Piik.Shim.js" />
    <EmbeddedResource Include="Resources\setup.html" LogicalName="Piik.Setup.html" />
    <EmbeddedResource Include="..\..\public\favicon.ico" LogicalName="Piik.Icon.ico" />
    <EmbeddedResource Include="Resources\PiikAudio.exe.gz" LogicalName="Piik.Audio.gz" Condition="Exists('Resources\PiikAudio.exe.gz')" />
    <EmbeddedResource Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" LogicalName="Piik.WebView2Loader.dll" Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')" />
  </ItemGroup>
</Project>
