# 声网控制台 → 项目管理 → RTC 项目 → App ID / App Certificate
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
# 声网 REST 用量查询：项目 ID、Customer ID 和 Customer Secret，仅后端使用
AGORA_PROJECT_ID=
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
# 服务状态缓存秒数，默认 300（5 分钟），有效范围 1–86400
RTC_USAGE_CACHE_SECONDS=300
# 火山 RTC 应用凭据，以及具有账单资源包查询权限的访问密钥
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=
VOLC_ACCESS_KEY_ID=
VOLC_ACCESS_KEY_SECRET=
# 即构 RTC 应用凭据
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
# 即构控制台登录 Cookie 文件（仅后端；加入 .gitignore 的 data 目录，过期时需替换）
ZEGO_COOKIE_FILE=./data/zego-cookie.txt
PORT=3000
# 对外部署时填完整 HTTPS 域名；留空仅供本地开发
PUBLIC_ORIGIN=
